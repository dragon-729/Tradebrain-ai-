# Copy to .env for local use. NEVER commit .env. In production set these as
# environment variables / secrets on your backend host (Render, Fly, Railway...).

# --- Database / Supabase ---
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=documents

# --- Gemini API keys (add as many as you like: _6, _7, ...) ---
# Use only keys/projects you are independently authorized to use.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# --- AI client behaviour ---
AI_TIMEOUT_SEC=90
AI_MAX_ATTEMPTS=4
AI_MAX_INLINE_WAIT_SEC=15
KEY_HEALTH_INTERVAL_SEC=600

# --- Admin dashboard (/admin). Long random string; leave empty to disable ---
ADMIN_TOKEN=

# --- Limits ---
MAX_UPLOAD_MB=25
MAX_PAGES=400
MAX_OCR_PAGES=40
